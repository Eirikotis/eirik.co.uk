# Server-only model configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

# Standard PostgreSQL connection
DATABASE_URL=postgresql://user:password@host:5432/eirik
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=5

# Private transcript viewer
ADMIN_USERNAME=eirik
ADMIN_PASSWORD=

# Abuse protection. Use a long, random value.
RATE_LIMIT_SALT=
RATE_LIMIT_PER_HOUR=20
